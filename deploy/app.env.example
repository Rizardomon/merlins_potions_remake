# Copie para deploy/app.env (NÃO versionado — o .gitignore já cobre deploy/*.env)
# e ajuste ao ambiente.

TAG=latest

# Portas publicadas no host (as portas INTERNAS dos containers seguem 3000/3001).
WEB_PORT=3000
SERVER_PORT=3001

# Onde publicar as portas. 127.0.0.1 quando o proxy reverso roda na MESMA máquina.
# Um IP da LAN expõe os containers na rede — nesse caso restrinja no firewall.
BIND_ADDR=127.0.0.1

# Domínio público do frontend — vira a origem liberada no CORS da API.
WEB_ORIGIN=https://app.exemplo.com.br

# Postgres (obrigatória). Em produção use um banco externo/gerenciado.
DATABASE_URL=postgres://<user>:<senha>@<host>:5432/<database>

# Postgres local de dev/CI (profile `dev-db` do compose). Não usado no deploy padrão.
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=app
# POSTGRES_PORT=5432

# Swagger em /api/docs (default em produção: desligado)
SWAGGER_ENABLED=false
