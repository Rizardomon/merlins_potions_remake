# Envs carregadas pelo `pnpm dev:all` e repassadas aos apps.
# Copie para .env (não versionado). Os defaults já cobrem o dev — este arquivo é o lugar
# de sobrepor algo pontualmente.

# API_PORT=3011
# WEB_ORIGIN=http://localhost:3010
# API_URL=http://localhost:3011/api

# Postgres (obrigatória). Sobe o serviço local com:
#   docker compose -f deploy/docker-compose.yml --profile dev-db up -d postgres
DATABASE_URL=postgres://app:app@localhost:5432/app
