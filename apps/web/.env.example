# Base da API NestJS usada pelo BFF (rotas em src/app/api/*). Server-side apenas —
# sem prefixo NEXT_PUBLIC_, este valor nunca chega ao browser.
API_URL=http://localhost:3011/api

# URL absoluta da aplicação Next.js — usada por RSC para construir URLs de fetch sem depender de browser.
# Em produção/preview, defina para a URL pública (ex.: https://merlins-potions.example.com).
NEXT_PUBLIC_APP_URL=http://localhost:3010
