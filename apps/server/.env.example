# Porta da API (o global prefix é /api → http://localhost:3001/api)
API_PORT=3001

# Origem do frontend liberada no CORS
WEB_ORIGIN=http://localhost:3000

# Swagger em /api/docs. Sem valor: ligado fora de produção, desligado em produção.
# SWAGGER_ENABLED=true

# Postgres. Opcional no template (repositories são em memória). Obrigatória ao ligar
# a persistência — ver apps/server/src/modules/_example/.
# DATABASE_URL=postgres://user:pass@localhost:5432/app
