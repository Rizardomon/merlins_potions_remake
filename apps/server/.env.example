# Porta da API (o global prefix é /api → http://localhost:3011/api)
API_PORT=3011

# Origem do frontend liberada no CORS
WEB_ORIGIN=http://localhost:3010

# Swagger em /api/docs. Sem valor: ligado fora de produção, desligado em produção.
# SWAGGER_ENABLED=true

# Postgres (obrigatória). Em dev, suba o serviço do compose (profile dev-db):
#   docker compose -f deploy/docker-compose.yml --profile dev-db up -d postgres
DATABASE_URL=postgres://app:app@localhost:5432/app
